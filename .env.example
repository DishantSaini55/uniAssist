# LLM: mock = deterministic templates (no model needed). ollama = local Ollama explanation + tool planning.
LLM_MODE=mock
LOCAL_LLM_MODEL=llama3.1:8b
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# Retrieval
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNKING=section
RETRIEVAL_TOP_K=5
MIN_SIMILARITY=0.45
STRONG_SIMILARITY=0.64

# Paths (defaults shown)
# RUNTIME_DIR=./runtime
# AUTO_BOOTSTRAP=1
